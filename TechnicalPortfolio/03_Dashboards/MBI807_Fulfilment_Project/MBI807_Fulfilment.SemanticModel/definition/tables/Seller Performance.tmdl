	column late_orders
		dataType: double
		formatString: 0
		lineageTag: eb9c2ae0-975e-408f-bd7c-599b6491401c
		summarizeBy: sum
		sourceColumn: late_orders

		annotation SummarizationSetBy = Automatic

	column on_time_rate_pct
		dataType: double
		formatString: 0.00
		lineageTag: 1186c802-18cd-45b9-8e79-b9f4f137f9dd
		summarizeBy: sum
		sourceColumn: on_time_rate_pct

		annotation SummarizationSetBy = Automatic

	column avg_delivery_days
		dataType: double
		formatString: 0.00
		lineageTag: 724f86c3-3aa8-431f-b759-c09c90227cc0
		summarizeBy: sum
		sourceColumn: avg_delivery_days

		annotation SummarizationSetBy = Automatic

	column avg_processing_days
		dataType: double
		formatString: 0.00
		lineageTag: b306dd1c-5c80-4b9d-a8a9-1af683274a7b
		summarizeBy: sum
		sourceColumn: avg_processing_days

		annotation SummarizationSetBy = Automatic

	column avg_transit_days
		dataType: double
		formatString: 0.00
		lineageTag: ef1ff97c-96e0-4ddf-b265-90aa365f030e
		summarizeBy: sum
		sourceColumn: avg_transit_days

		annotation SummarizationSetBy = Automatic

	column item_lines
		dataType: double
		formatString: 0
		lineageTag: 380ef7e8-075e-4384-8f8e-80b6775d7881
		summarizeBy: sum
		sourceColumn: item_lines

		annotation SummarizationSetBy = Automatic

	column item_value
		dataType: double
		formatString: 0.00
		lineageTag: a722bca1-a96f-4711-a780-cf00f9ff38e7
		summarizeBy: sum
		sourceColumn: item_value

		annotation SummarizationSetBy = Automatic

	column freight_value
		dataType: double
		formatString: 0.00
		lineageTag: fed76a99-1f17-4e46-aa29-bf5b8fdd9c96
		summarizeBy: sum
		sourceColumn: freight_value

		annotation SummarizationSetBy = Automatic

	column freight_to_item_value_pct
		dataType: double
		formatString: 0.00
		lineageTag: f4bf1daa-91b0-430b-8a00-01c3e4bb04e3
		summarizeBy: sum
		sourceColumn: freight_to_item_value_pct

		annotation SummarizationSetBy = Automatic

	column 'Seller Label' =
			
			'Seller Performance'[seller_city]
			    & " - "
			    & LEFT('Seller Performance'[seller_id], 8)
		lineageTag: c61a516e-3ac0-4d06-bb89-ebd8e7996adf
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Seller Rank' =
			
			VAR CurrentRate =
			    'Seller Performance'[on_time_rate_pct]
			
			VAR CurrentSeller =
			    'Seller Performance'[seller_id]
			
			VAR CurrentEligible =
			    'Seller Performance'[eligible_orders]
			
			RETURN
			IF(
			    CurrentEligible >= 100
			        && NOT ISBLANK(CurrentRate),
			
			    1 +
			    COUNTROWS(
			        FILTER(
			            ALL('Seller Performance'),
			
			            'Seller Performance'[eligible_orders] >= 100
			                &&
			            NOT ISBLANK('Seller Performance'[on_time_rate_pct])
			                &&
			            (
			                'Seller Performance'[on_time_rate_pct] < CurrentRate
			
			                ||
			
			                (
			                    'Seller Performance'[on_time_rate_pct] = CurrentRate
			                        &&
			                    'Seller Performance'[seller_id] < CurrentSeller
			                )
			            )
			        )
			    )
			)
		formatString: 0
		lineageTag: b9860d1b-df74-469d-aa6e-2199a72d3a53
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column 'Seller Late Rank' =
			
			VAR CurrentLate =
			    'Seller Performance'[late_orders]
			
			VAR CurrentSeller =
			    'Seller Performance'[seller_id]
			
			VAR CurrentEligible =
			    'Seller Performance'[eligible_orders]
			
			RETURN
			IF(
			    CurrentEligible >= 100,
			    1 +
			    COUNTROWS(
			        FILTER(
			            ALL('Seller Performance'),
			            'Seller Performance'[eligible_orders] >= 100
			                &&
			            (
			                'Seller Performance'[late_orders] > CurrentLate
			                ||
			                (
			                    'Seller Performance'[late_orders] = CurrentLate
			                    &&
			                    'Seller Performance'[seller_id] < CurrentSeller
			                )
			            )
			        )
			    )
			)
		formatString: 0
		lineageTag: ebed6231-99e9-4756-b023-b979d734988a
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

