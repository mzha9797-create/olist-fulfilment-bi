table 'Seller Performance'
	lineageTag: 4921427b-8a27-4050-beb8-5513e7737875

	measure 'Total Sellers' =
			
			DISTINCTCOUNT('Seller Performance'[seller_id])
		formatString: #,0
		lineageTag: 8805ebca-f270-4b75-b3c5-61821253174d

	measure 'Associated Orders' =
			
			SUM('Seller Performance'[associated_orders])
		formatString: #,0
		lineageTag: fae7d213-168f-4517-8b4c-04e34882ec4e

	measure 'Eligible Seller Orders' =
			
			SUM('Seller Performance'[eligible_orders])
		formatString: #,0
		lineageTag: 0d9925e6-9b5e-4277-8271-52140487310f

		annotation PBI_FormatHint = {"isDecimal":true}

	measure 'Seller On-time Delivery Rate' =
			
			DIVIDE(
			    SUM('Seller Performance'[eligible_orders])
			        - SUM('Seller Performance'[late_orders]),
			    SUM('Seller Performance'[eligible_orders])
			)
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: c0213769-cd87-45e6-b3e5-cd044fdaeb02

	measure 'Seller On-time Rate' =
			
			DIVIDE(
			    SUM('Seller Performance'[eligible_orders])
			        - SUM('Seller Performance'[late_orders]),
			    SUM('Seller Performance'[eligible_orders])
			)
		lineageTag: 22b7e7ee-7724-41e4-afaf-856b39f41ae0

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Seller Performance Rank' =
			
			VAR CurrentSeller =
			    SELECTEDVALUE('Seller Performance'[seller_id])
			
			VAR CurrentRate =
			    [Seller On-time Rate]
			
			VAR SellerPool =
			    FILTER(
			        ADDCOLUMNS(
			            CALCULATETABLE(
			                VALUES('Seller Performance'[seller_id]),
			                REMOVEFILTERS(
			                    'Seller Performance'[seller_id],
			                    'Seller Performance'[Seller Label]
			                )
			            ),
			            "__Eligible",
			                CALCULATE([Eligible Seller Orders]),
			            "__Rate",
			                CALCULATE([Seller On-time Rate])
			        ),
			        [__Eligible] >= 100
			            && NOT ISBLANK([__Rate])
			    )
			
			RETURN
			IF(
			    [Eligible Seller Orders] >= 100
			        && NOT ISBLANK(CurrentRate),
			    1 +
			        COUNTROWS(
			            FILTER(
			                SellerPool,
			                [__Rate] < CurrentRate
			                    ||
			                (
			                    [__Rate] = CurrentRate
			                        &&
			                    'Seller Performance'[seller_id] < CurrentSeller
			                )
			            )
			        )
			)
		formatString: 0
		lineageTag: 37f63d12-3aeb-486b-a0a7-6385b7f198d4

	measure 'Seller Late Orders' =
			
			SUM('Seller Performance'[late_orders])
		lineageTag: 24569800-759d-499e-ae11-7c8e71f48ad9

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Avg Seller Processing Days' =
			
			DIVIDE(SUM('Seller Performance'[processing_sum]), SUM('Seller Performance'[processing_n]))
		lineageTag: 203ddc0f-87f1-4c40-92b1-9cba42265db4

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Avg Seller Processing Benchmark' =
			
			CALCULATE(
			    DIVIDE(SUM('Seller Performance'[processing_sum]), SUM('Seller Performance'[processing_n])),
			    FILTER(
			        ALL('Seller Performance'),
			        'Seller Performance'[eligible_orders] >= 100
			    )
			)
		lineageTag: db4cc110-0b48-445e-a23e-4dbf77cea0d9

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Seller On-time Benchmark' =
			
			DIVIDE(
			    SUMX(
			        FILTER(
			            ALL('Seller Performance'),
			            'Seller Performance'[eligible_orders] >= 100
			        ),
			        'Seller Performance'[eligible_orders] - 'Seller Performance'[late_orders]
			    ),
			    SUMX(
			        FILTER(
			            ALL('Seller Performance'),
			            'Seller Performance'[eligible_orders] >= 100
			        ),
			        'Seller Performance'[eligible_orders]
			    )
			)
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 2d73ac64-74cc-4342-8c78-8031487462d7

	measure 'Priority Seller' =
			
			IF(
			    [Eligible Seller Orders] >= 100
			        && [Avg Seller Processing Days] > [Avg Seller Processing Benchmark]
			        && [Seller On-time Rate] < [Seller On-time Benchmark],
			    1,
			    0
			)
		formatString: 0
		lineageTag: 438d6db8-f164-407a-bcbd-b7a4b237f721

	column seller_id
		dataType: string
		lineageTag: 332c0725-bf84-4084-be3c-cb2986c458ef
		summarizeBy: none
		sourceColumn: seller_id

		annotation SummarizationSetBy = Automatic

	column seller_city
		dataType: string
