	column associated_orders
		dataType: double
		formatString: 0
		lineageTag: 327a5989-0b4f-46df-aed7-6a2f92b2e64a
		summarizeBy: sum
		sourceColumn: associated_orders

		annotation SummarizationSetBy = Automatic

	column eligible_orders
		dataType: double
		formatString: 0
		lineageTag: 60980eac-0c1f-4076-b0df-9a97bdb3c60f
		summarizeBy: sum
		sourceColumn: eligible_orders

