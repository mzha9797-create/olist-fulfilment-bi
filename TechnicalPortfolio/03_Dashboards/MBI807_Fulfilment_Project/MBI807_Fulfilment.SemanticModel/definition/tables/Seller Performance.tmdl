	partition 'Seller Performance' = m
		mode: import
		source =
				let
				  Source = Csv.Document(File.Contents("C:/Portfolio/olist-fulfilment-bi/TechnicalPortfolio/04_Data_Examples/clean/vw_seller_performance_powerbi.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				  Headers = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				  Typed = Table.TransformColumnTypes(Headers, {{"seller_id", type text},{"seller_city", type text},{"seller_state", type text},{"associated_orders", type number},{"eligible_orders", type number},{"late_orders", type number},{"on_time_rate_pct", type number},{"avg_delivery_days", type number},{"avg_processing_days", type number},{"avg_transit_days", type number},{"item_lines", type number},{"item_value", type number},{"freight_value", type number},{"freight_to_item_value_pct", type number},{"delivery_sum", type number},{"delivery_n", type number},{"processing_sum", type number},{"processing_n", type number},{"transit_sum", type number},{"transit_n", type number}}, "en-US")
				in Typed

	annotation PBI_ResultType = Table

