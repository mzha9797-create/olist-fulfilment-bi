	column weight_sum
		dataType: double
		lineageTag: 7c58b02d-d579-425c-8047-489d6e2f9d0d
		summarizeBy: sum
		sourceColumn: weight_sum

	column weight_n
		dataType: double
		lineageTag: 31bc935d-7a40-4e7d-9670-5ba74dd7009c
		summarizeBy: sum
		sourceColumn: weight_n

	partition 'Category Performance' = m
		mode: import
		source =
				let
				  Source = Csv.Document(File.Contents("C:/Portfolio/olist-fulfilment-bi/TechnicalPortfolio/04_Data_Examples/clean/vw_category_performance_powerbi.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				  Headers = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				  Typed = Table.TransformColumnTypes(Headers, {{"category_display", type text},{"distinct_products", type number},{"catalog_products", type number},{"associated_orders", type number},{"eligible_orders", type number},{"late_orders", type number},{"on_time_rate_pct", type number},{"avg_delivery_days", type number},{"avg_processing_days", type number},{"avg_transit_days", type number},{"item_lines", type number},{"item_value", type number},{"freight_value", type number},{"freight_to_item_value_pct", type number},{"avg_product_weight_g", type number},{"delivery_sum", type number},{"delivery_n", type number},{"processing_sum", type number},{"processing_n", type number},{"transit_sum", type number},{"transit_n", type number},{"weight_sum", type number},{"weight_n", type number}}, "en-US")
				in Typed

