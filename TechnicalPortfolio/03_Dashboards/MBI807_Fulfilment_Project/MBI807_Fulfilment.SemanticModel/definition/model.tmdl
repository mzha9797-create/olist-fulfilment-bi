model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-US
	valueFilterBehavior: independent
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 1

annotation PBI_QueryOrder = ["Category Performance","Seller Performance","State Performance","Order Explorer"]

annotation PBI_ProTooling = ["DevMode"]

ref table 'Category Performance'
ref table 'Seller Performance'
ref table 'State Performance'
ref table 'Order Explorer'

ref cultureInfo en-US

